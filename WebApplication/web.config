<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- SECURITY FIX: IIS configuration for additional security headers -->
  <!-- This file provides IIS-level security configuration for ASP.NET Core applications -->
  
  <system.webServer>
    <!-- SECURITY FIX: Remove server information headers at IIS level -->
    <!-- This prevents IIS from revealing version information -->
    <httpProtocol>
      <customHeaders>
        <!-- SECURITY FIX: Remove X-Powered-By header -->
        <!-- Hides that the site is powered by ASP.NET -->
        <remove name="X-Powered-By" />
        
        <!-- SECURITY FIX: Remove Server header -->
        <!-- Hides server type and version information -->
        <remove name="Server" />
        
        <!-- SECURITY FIX: Add X-Frame-Options: DENY -->
        <!-- Prevents clickjacking attacks by blocking iframe embedding -->
        <add name="X-Frame-Options" value="DENY" />
        
        <!-- SECURITY FIX: Add X-Content-Type-Options: nosniff -->
        <!-- Prevents MIME type sniffing which can lead to XSS attacks -->
        <add name="X-Content-Type-Options" value="nosniff" />
        
        <!-- SECURITY FIX: Add Referrer-Policy -->
        <!-- Controls how much referrer information is sent with requests -->
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        
        <!-- SECURITY FIX: Add X-XSS-Protection -->
        <!-- Enables XSS filter in browsers that support it -->
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>
    
    <!-- SECURITY FIX: Enable HTTP Strict Transport Security (HSTS) at IIS level -->
    <!-- This enforces HTTPS for all requests to the domain -->
    <!-- Note: This is a backup to the HSTS configured in Program.cs -->
    <!-- Uncomment the following section if you want to enforce HSTS at IIS level -->
    <!--
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
      </customHeaders>
    </httpProtocol>
    -->
    
    <!-- SECURITY FIX: Enable request filtering to prevent malicious requests -->
    <!-- Blocks requests with potentially dangerous content -->
    <security>
      <requestFiltering>
        <!-- SECURITY FIX: Limit maximum URL length -->
        <!-- Prevents buffer overflow attacks via long URLs -->
        <requestLimits maxUrl="4096" maxQueryString="2048" />
        
        <!-- SECURITY FIX: Block double-encoded requests -->
        <!-- Prevents evasion techniques used by attackers -->
        <allowDoubleEscaping="false" />
        
        <!-- SECURITY FIX: Block unlisted file extensions -->
        <!-- Only allows specific file extensions to be served -->
        <fileExtensions allowUnlisted="false">
          <add fileExtension=".html" allowed="true" />
          <add fileExtension=".css" allowed="true" />
          <add fileExtension=".js" allowed="true" />
          <add fileExtension=".json" allowed="true" />
          <add fileExtension=".png" allowed="true" />
          <add fileExtension=".jpg" allowed="true" />
		    <add fileExtension=".jpeg" allowed="true" />
		    <add fileExtension=".pdf" allowed="true" />
		    <add fileExtension=".docx" allowed="true" />
		    <add fileExtension=".word" allowed="true" />
		    <add fileExtension=".xlsx" allowed="true" />
		    <add fileExtension=".gif" allowed="true" />
          <add fileExtension=".svg" allowed="true" />
          <add fileExtension=".ico" allowed="true" />
          <add fileExtension=".woff" allowed="true" />
          <add fileExtension=".woff2" allowed="true" />
          <add fileExtension=".ttf" allowed="true" />
          <add fileExtension=".eot" allowed="true" />
        </fileExtensions>
        
        <!-- SECURITY FIX: Block hidden segments -->
        <!-- Prevents access to hidden directories and files -->
        <hiddenSegments>
          <add segment="bin" />
          <add segment="App_Code" />
          <add segment="App_GlobalResources" />
          <add segment="App_LocalResources" />
          <add segment="App_WebReferences" />
          <add segment="App_Data" />
          <add segment="App_Browsers" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    
    <!-- SECURITY FIX: Disable HTTP methods that are not needed -->
    <!-- Reduces attack surface by disabling unused HTTP verbs -->
    <!-- Note: This is configured at application level in Program.cs -->
    
    <!-- SECURITY FIX: Enable SSL/TLS for secure connections -->
    <!-- Uncomment the following to enforce HTTPS at IIS level -->
    <!--
    <security>
      <access sslFlags="Ssl, SslNegotiateCert, SslRequireCert" />
    </security>
    -->
  </system.webServer>
</configuration>
